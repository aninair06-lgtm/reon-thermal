  "components": [
    {
      "name": "Pill Tabs",
      "kind": "nav",
      "refersTo": "tab-active",
      "description": "Frosted pill bar of section anchors; the current section is a REON-green pill.",
      "html": "<nav class=\"ds-tabs\"><a href=\"#\" aria-current=\"true\">Health</a><a href=\"#\">Early warning</a><a href=\"#\">Thermal</a></nav>",
      "css": ":host{--ink:#0A1A11;--ink-2:#4A554F;--accent:#00A600;--card:rgba(245,247,243,.66);--card-edge:rgba(255,255,255,.9);--pill:#0A1A11;--pill-ink:#F5F7F3;--band:#0A1A11;--band-ink:#F5F7F3;--band-ink-2:#B6BAB4;--band-line:rgba(255,255,255,.09);--band-3:rgba(255,255,255,.09);--shadow:0 1px 2px rgba(10,26,17,.06), 0 16px 36px -16px rgba(0,60,20,.28);font-family:'Geist','Neue Montreal',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-tabs{display:inline-flex;gap:4px;padding:4px;border-radius:999px;background:var(--card);border:1px solid var(--card-edge);box-shadow:var(--shadow);backdrop-filter:blur(16px) saturate(140%)} .ds-tabs a{padding:8px 16px;border-radius:999px;text-decoration:none;font-size:14px;font-weight:500;color:var(--ink-2);transition:background .2s,color .2s} .ds-tabs a:hover{color:var(--ink)} .ds-tabs a:focus-visible{outline:2px solid var(--accent);outline-offset:3px} .ds-tabs a[aria-current=\"true\"]{background:var(--pill);color:var(--pill-ink)}"
    },
    {
      "name": "Glass Factor Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Frosted card with a light tabular numeral, status chip and fill bar.",
      "html": "<article class=\"ds-card\"><div class=\"ds-fl\">Hottest cell <span class=\"ds-chip-ok\">Cool</span></div><div class=\"ds-fv\">39.8<small>°C</small></div><div class=\"ds-bar\"><i style=\"width:49%\"></i></div><div class=\"ds-fs\"><span>Limit 60 °C</span><span>20.2 K margin</span></div></article>",
      "css": ":host{--ink:#0A1A11;--ink-2:#4A554F;--accent:#00A600;--card:rgba(245,247,243,.66);--card-edge:rgba(255,255,255,.9);--pill:#0A1A11;--pill-ink:#F5F7F3;--band:#0A1A11;--band-ink:#F5F7F3;--band-ink-2:#B6BAB4;--band-line:rgba(255,255,255,.09);--band-3:rgba(255,255,255,.09);--shadow:0 1px 2px rgba(10,26,17,.06), 0 16px 36px -16px rgba(0,60,20,.28);font-family:'Geist','Neue Montreal',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-card{width:260px;background:var(--card);border:1px solid var(--card-edge);border-radius:16px;box-shadow:var(--shadow);backdrop-filter:blur(20px) saturate(150%);padding:22px;color:var(--ink)} .ds-fl,.ds-fs{display:flex;justify-content:space-between;align-items:center;font-size:14px;color:var(--ink-2)} .ds-fs{font-size:13px;margin-top:12px} .ds-fv{font-size:40px;font-weight:300;letter-spacing:-.045em;line-height:1;margin:14px 0 4px} .ds-fv small{font-size:17px;color:var(--ink-2);margin-left:3px;letter-spacing:-.01em} .ds-bar{height:6px;border-radius:6px;background:rgba(10,26,17,.10);overflow:hidden;margin-top:12px} .ds-bar i{display:block;height:100%;border-radius:6px;background:linear-gradient(90deg,#4CDE4C,#00A600)} .ds-chip-ok{font-size:12.5px;font-weight:550;padding:4px 10px;border-radius:999px;background:rgba(0,166,0,.13);color:#066316}"
    },
    {
      "name": "Status Chips",
      "kind": "chip",
      "refersTo": "chip-ok",
      "description": "Semantic text on a tinted pill; neutral variant for context.",
      "html": "<div class=\"ds-row\"><span class=\"ds-chip ok\">All caught</span><span class=\"ds-chip warn\">Uneven</span><span class=\"ds-chip bad\">74.8 °C peak</span><span class=\"ds-chip n\">per cabinet</span></div>",
      "css": ":host{--ink:#0A1A11;--ink-2:#4A554F;--accent:#00A600;--card:rgba(245,247,243,.66);--card-edge:rgba(255,255,255,.9);--pill:#0A1A11;--pill-ink:#F5F7F3;--band:#0A1A11;--band-ink:#F5F7F3;--band-ink-2:#B6BAB4;--band-line:rgba(255,255,255,.09);--band-3:rgba(255,255,255,.09);--shadow:0 1px 2px rgba(10,26,17,.06), 0 16px 36px -16px rgba(0,60,20,.28);font-family:'Geist','Neue Montreal',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-row{display:flex;gap:8px} .ds-chip{display:inline-flex;font-size:12.5px;font-weight:550;padding:4px 10px;border-radius:999px;white-space:nowrap} .ds-chip.ok{background:rgba(0,166,0,.13);color:#066316} .ds-chip.warn{background:rgba(200,130,20,.15);color:#8A5208} .ds-chip.bad{background:rgba(194,53,42,.12);color:#A8281F} .ds-chip.n{background:rgba(10,26,17,.10);color:var(--ink-2)}"
    },
    {
      "name": "Simulated-Data Tag",
      "kind": "chip",
      "refersTo": "",
      "description": "Mandatory dashed pill with a green dot in the top bar.",
      "html": "<span class=\"ds-sim\"><b></b>Simulated data</span>",
      "css": ":host{--ink:#0A1A11;--ink-2:#4A554F;--accent:#00A600;--card:rgba(245,247,243,.66);--card-edge:rgba(255,255,255,.9);--pill:#0A1A11;--pill-ink:#F5F7F3;--band:#0A1A11;--band-ink:#F5F7F3;--band-ink-2:#B6BAB4;--band-line:rgba(255,255,255,.09);--band-3:rgba(255,255,255,.09);--shadow:0 1px 2px rgba(10,26,17,.06), 0 16px 36px -16px rgba(0,60,20,.28);font-family:'Geist','Neue Montreal',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-sim{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:500;color:var(--ink-2);padding:6px 12px;border:1px dashed rgba(10,26,17,.3);border-radius:999px;letter-spacing:.02em} .ds-sim b{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 3px rgba(0,166,0,.25)}"
    },
    {
      "name": "Fault Pill Toggles",
      "kind": "chip",
      "refersTo": "pill-toggle-pressed",
      "description": "On the band: outlined pills with a fault-hue dot; pressed fills white.",
      "html": "<div class=\"ds-band\"><div class=\"ds-pills\"><button aria-pressed=\"true\"><i style=\"background:#0A86A8\"></i>Corrosion</button><button aria-pressed=\"false\"><i style=\"background:#7457F5\"></i>Tab or weld</button><button aria-pressed=\"false\"><i style=\"background:#CF3779\"></i>Damage</button></div></div>",
      "css": ":host{--ink:#0A1A11;--ink-2:#4A554F;--accent:#00A600;--card:rgba(245,247,243,.66);--card-edge:rgba(255,255,255,.9);--pill:#0A1A11;--pill-ink:#F5F7F3;--band:#0A1A11;--band-ink:#F5F7F3;--band-ink-2:#B6BAB4;--band-line:rgba(255,255,255,.09);--band-3:rgba(255,255,255,.09);--shadow:0 1px 2px rgba(10,26,17,.06), 0 16px 36px -16px rgba(0,60,20,.28);font-family:'Geist','Neue Montreal',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-band{background:var(--band);padding:20px;border-radius:16px} .ds-pills{display:flex;gap:6px;flex-wrap:wrap} .ds-pills button{font:inherit;cursor:pointer;border:1px solid var(--band-line);background:transparent;color:var(--band-ink-2);padding:7px 13px;border-radius:999px;font-size:13.5px;font-weight:500;display:inline-flex;align-items:center;gap:7px;transition:background .2s,color .2s,border-color .2s} .ds-pills button:hover{color:var(--band-ink);border-color:var(--band-3)} .ds-pills button:focus-visible{outline:2px solid #00D000;outline-offset:3px} .ds-pills button[aria-pressed=\"true\"]{background:var(--band-ink);color:#0A1A11;border-color:var(--band-ink)} .ds-pills i{width:8px;height:8px;border-radius:50%}"
    },
    {
      "name": "Band Offer Card",
      "kind": "card",
      "refersTo": "band-card",
      "description": "Dark-band card: light peak numeral, warm thermometer with limit tick, chip and pill button.",
      "html": "<div class=\"ds-band\"><article class=\"ds-dcard\"><h3>Pre-cool to 40 °C</h3><div class=\"ds-pk\">56.2<small>°C peak</small></div><div class=\"ds-therm\"><i style=\"width:46%\"></i><s style=\"left:57%\"></s></div><div class=\"ds-orow\"><span class=\"ds-dchip\">3.8 K under 60</span><button class=\"ds-btn\">Compare all</button></div></article></div>",
      "css": ":host{--ink:#0A1A11;--ink-2:#4A554F;--accent:#00A600;--card:rgba(245,247,243,.66);--card-edge:rgba(255,255,255,.9);--pill:#0A1A11;--pill-ink:#F5F7F3;--band:#0A1A11;--band-ink:#F5F7F3;--band-ink-2:#B6BAB4;--band-line:rgba(255,255,255,.09);--band-3:rgba(255,255,255,.09);--shadow:0 1px 2px rgba(10,26,17,.06), 0 16px 36px -16px rgba(0,60,20,.28);font-family:'Geist','Neue Montreal',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-band{background:var(--band);padding:20px;border-radius:16px} .ds-dcard{width:260px;background:rgba(255,255,255,.045);border:1px solid var(--band-line);border-radius:16px;padding:22px;color:var(--band-ink)} .ds-dcard h3{margin:0;font-size:17px;font-weight:550;letter-spacing:-.01em} .ds-pk{font-size:40px;font-weight:300;letter-spacing:-.045em;line-height:1;margin-top:14px} .ds-pk small{font-size:16px;color:var(--band-ink-2);margin-left:2px;letter-spacing:0} .ds-therm{position:relative;height:8px;border-radius:6px;background:var(--band-3);margin:16px 0 8px} .ds-therm i{position:absolute;left:0;top:0;bottom:0;border-radius:6px;background:linear-gradient(90deg,#FFC24A,#FF7A45)} .ds-therm s{position:absolute;top:-5px;bottom:-5px;width:2px;background:var(--band-ink);border-radius:2px} .ds-orow{display:flex;justify-content:space-between;align-items:center;margin-top:12px} .ds-dchip{font-size:13px;padding:6px 11px;border-radius:999px;background:rgba(0,208,0,.14);color:#4CDE4C} .ds-btn{font:inherit;cursor:pointer;border:1px solid var(--band-line);background:var(--band-3);color:var(--band-ink);border-radius:999px;padding:8px 14px;font-size:13.5px;font-weight:500;transition:background .2s} .ds-btn:hover{background:rgba(255,255,255,.16)} .ds-btn:focus-visible{outline:2px solid #00D000;outline-offset:3px}"
    },
    {
      "name": "Year Scrubber",
      "kind": "input",
      "refersTo": "button-play",
      "description": "Play button plus accent-filled week slider; playback pops new bypass rings.",
      "html": "<div class=\"ds-scrub\"><button class=\"ds-play\" aria-label=\"Play the year\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M4 2.5v11l9.5-5.5z\" fill=\"currentColor\"/></svg></button><input class=\"ds-range\" type=\"range\" min=\"0\" max=\"51\" value=\"16\" style=\"--p:31%\" aria-label=\"Week\"><div class=\"ds-wk\"><b>Week 17</b><span>Apr · site 28 °C</span></div></div>",
      "css": ":host{--ink:#0A1A11;--ink-2:#4A554F;--accent:#00A600;--card:rgba(245,247,243,.66);--card-edge:rgba(255,255,255,.9);--pill:#0A1A11;--pill-ink:#F5F7F3;--band:#0A1A11;--band-ink:#F5F7F3;--band-ink-2:#B6BAB4;--band-line:rgba(255,255,255,.09);--band-3:rgba(255,255,255,.09);--shadow:0 1px 2px rgba(10,26,17,.06), 0 16px 36px -16px rgba(0,60,20,.28);font-family:'Geist','Neue Montreal',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums} .ds-scrub{display:flex;align-items:center;gap:14px;width:520px} .ds-play{width:42px;height:42px;flex:none;border-radius:50%;border:0;background:var(--pill);color:var(--pill-ink);display:grid;place-items:center;cursor:pointer;box-shadow:0 6px 16px -6px rgba(0,0,0,.35);transition:transform .15s} .ds-play:hover{transform:scale(1.06)} .ds-play:active{transform:scale(.96)} .ds-play:focus-visible{outline:2px solid var(--accent);outline-offset:3px} .ds-range{flex:1;-webkit-appearance:none;appearance:none;background:transparent;height:24px;margin:0;accent-color:var(--accent)} .ds-range::-webkit-slider-runnable-track{height:6px;border-radius:6px;background:linear-gradient(90deg,var(--accent) var(--p),rgba(10,26,17,.10) var(--p))} .ds-range::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;margin-top:-7px;border-radius:50%;background:#F9FAF8;border:2px solid var(--accent);box-shadow:0 2px 6px rgba(0,0,0,.2)} .ds-range:focus-visible{outline:2px solid var(--accent);outline-offset:3px} .ds-wk{min-width:116px;text-align:right;color:var(--ink)} .ds-wk b{display:block;font-size:20px;font-weight:450;letter-spacing:-.02em} .ds-wk span{font-size:12.5px;color:var(--ink-2)}"
    }
  ],
  "narrative": {
    "northStar": "The Cabinet Credit Score",
    "overview": "One health number up top, the factors that move it beneath, the history and the offers in a dark band. The world is REON's own: an off-white ground lit by a soft neon-green glow, frosted white glass cards with 16px corners, big light numerals, and a REON-green band that the page descends into for the early-warning story. It reads as a calm consumer-grade dashboard laid over engineering data, not an engineering console of tables and alarm lists.\n\nColour carries meaning, never decoration. Green is REON's voice: whatever REON reads or does (its signal, its bypass rings, its flags, the accent on controls) is green. Heat has its own warm ramp and never borrows brand green. Fault kinds each own one fixed hue that follows them across pills, dots, 3D tags and timelines; bypass rings are always REON green, because a bypass is REON acting. Words are few; numbers and shapes do the talking, and a diagnosis is one or two plain sentences.\n\nBoth themes are first-class: a light theme by default and a dark theme via `prefers-color-scheme` or `data-theme=\"dark\"`, with every chart re-reading its colours from the tokens when the theme changes.",
    "keyCharacteristics": [
      "Off-white ground, neon-green glow, frosted glass cards (16px radius, soft offset shadow).",
      "A REON-green lower band with a 32px top radius holding the timeline, diagnosis and action cards.",
      "Big light-weight (300) tabular numerals with a small muted unit.",
      "Pill geometry for every control: tabs, toggles, chips, buttons, the play button.",
      "Charts drawn in SVG to their container's width, re-coloured from tokens on theme change.",
      "One authored motion moment: the year playback, where the health gauge's arc eases to each week's value, new bypass rings pop in and failing cells slide out of their shelf in the 3D pack."
    ],
    "rules": [
      {
        "name": "The REON Is Green Rule",
        "body": "Green means REON sensed or acted. Heat, health and faults never use green; status \"ok\" is the one semantic exception and stays on a tinted chip or a passing bar.",
        "section": "colors"
      },
      {
        "name": "The Separate Heat Rule",
        "body": "Temperature is drawn only with the warm heat ramp, never with brand colour or fault hues.",
        "section": "colors"
      },
      {
        "name": "The Fixed Fault Hue Rule",
        "body": "A fault kind's hue is assigned once and follows it into every pill, dot, tag and lane that names the fault. Bypass rings and outlines are REON green, never a fault hue (user decision).",
        "section": "colors"
      },
      {
        "name": "The Light Numeral Rule",
        "body": "The bigger the number, the lighter the weight: 300 at 40px and up, 400-450 for 20-28px stat values.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "`font-variant-numeric: tabular-nums` is set on the body and holds everywhere numbers change.",
        "section": "typography"
      },
      {
        "name": "The Soft Lift Rule",
        "body": "Shadows are soft, offset downward and green-tinted in light theme. No hard or stacked shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use neon green only for what REON reads or does: its signal, flags, bypass rings, and the words that name its conclusion.",
      "**Do** draw every temperature with the warm heat ramp, read from the `--h-*` tokens so both themes stay in step.",
      "**Do** keep each fault kind on its fixed hue across pills, dots, tags and lanes; keep bypass rings and outlines green.",
      "**Do** set big numbers light (300) and tabular with a smaller muted unit.",
      "**Do** explain a diagnosis in one or two plain sentences that name the cause, with bold neon emphasis on the deciding facts.",
      "**Do** carry the dashed \"Simulated data\" tag in the top bar and the simulated-data line in the footer on every surface.",
      "**Do** draw charts to their container width and redraw on resize and theme change.",
      "**Do** keep the REON wordmark as inline SVG in `currentColor`. The team publishes the project in its public GitHub repo; the page is not published as a claude.ai artifact."
    ],
    "donts": [
      "**Don't** colour heat, health or faults in brand green.",
      "**Don't** render the diagnostic flowchart's yes/no steps as the explanation.",
      "**Don't** add words where a number or a shape will do; labels stay short and sentence case.",
      "**Don't** use hard offset shadows or square corners on cards and controls.",
      "**Don't** animate anything beyond the year playback (gauge arc, ring pop, 3D slab transition) and short state transitions, and never ignore reduced motion.",
      "**Don't** reuse the layout reference's third-party name, logo or content."
    ]
  }
}